# --- Supabase (service role: worker only, never expose to browser) ---
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- Slack bot (scopes: chat:write, chat:write.public) ---
SLACK_BOT_TOKEN=xoxb-...
SLACK_CHANNEL_HIGH=#sm-high-conviction
SLACK_CHANNEL_FEED=#sm-feed
SLACK_CHANNEL_CLUSTERS=#sm-clusters
SLACK_CHANNEL_OPS=#sm-ops

# --- Hyperliquid ---
HL_API_URL=https://api.hyperliquid.xyz
HL_WS_URL=wss://api.hyperliquid.xyz/ws
# IP budget is 1200 weight/min; keep headroom for fills + other tooling on same IP
POLL_BUDGET_WEIGHT_PER_MIN=800
POLL_MIN_INTERVAL_SEC=5
ENABLE_PRIORITY_WS=false

# --- Behaviour ---
AGG_WINDOW_SEC=120
CONFIG_RELOAD_SEC=60
FILLS_SYNC_INTERVAL_SEC=900
RETENTION_DAYS=30
DRY_RUN=false
LOG_LEVEL=info
WORKER_ID=render-worker-1
TZ=Asia/Kolkata

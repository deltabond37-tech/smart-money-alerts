{
  "name": "@sma/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "dry-run": "tsx src/index.ts --dry-run",
    "test": "vitest run --passWithNoTests",
    "smoke": "tsx scripts/smoke.ts"
  },
  "dependencies": {
    "@sma/core": "workspace:*",
    "@slack/web-api": "^7.7.0",
    "@supabase/supabase-js": "^2.47.10",
    "p-limit": "^6.1.0",
    "pino": "^9.5.0",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.13",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
